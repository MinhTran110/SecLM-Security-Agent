# ==========================================
# Cấu hình Khóa API Gemini (Google AI Studio)
# ==========================================

# 1. Khóa mặc định (Tối thiểu 1 khóa)
GEMINI_API_KEY="AIzaSyYourPrimaryApiKeyHere"

# 2. Danh sách nhiều khóa API để tự động xoay vòng Round-Robin & Failover
# Lưu ý: Các khóa nên được tạo ở các Project khác nhau trên Google AI Studio để nhân hạn mức Free (15 RPM x N)
GEMINI_API_KEYS="AIzaSyKeyProject1,AIzaSyKeyProject2,AIzaSyKeyProject3"

# 3. Danh sách các đuôi (suffixes) khóa cần tự động loại trừ (Ví dụ các khóa của OpenClaw)
EXCLUDED_KEY_SUFFIXES="0ujA,xqhg"

# 4. Thời gian phạt Cooldown (giây) khi 1 khóa gặp lỗi 429 Quota Exceeded (Mặc định: 60s)
KEY_COOLDOWN_SECONDS=60.0

# ==========================================
# Cấu hình Vận hành Agent
# ==========================================
ENVIRONMENT="development"
DEFAULT_MODEL="gemini-3.5-flash"
MAX_ITERATIONS=5
NVD_API_TIMEOUT=10
TOOL_TIMEOUT_SECONDS=5.0
